# BsKeyTools .gitattributes
# Enforce LF line endings for all script files stored in git.
# This ensures file sizes computed by CI (Ubuntu/LF) match what
# Gitee raw serves, preventing false size-mismatch update failures.

# Default: normalize to LF on checkout
* text=auto eol=lf

# Line endings only. Encoding/BOM rules per file type live in AGENTS.md.

# MAXScript and related script files — always LF
*.ms   text eol=lf
*.mcr  text eol=lf
# Encrypted MAXScript is binary; LF normalization would corrupt it
*.mse  binary

# Python
*.py   text eol=lf

# cmd.exe needs CRLF (labels/goto break on LF-only files)
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Language / config files
*.lng  text eol=lf
# Some .ini are UTF-16LE; text=auto lets git detect them as binary
*.ini  text=auto eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Binary files — never touch line endings
*.exe  binary
*.dll  binary
*.dlm  binary
*.zip  binary
*.png  binary
*.gif  binary
*.jpg  binary
*.ico  binary
*.bmp  binary
*.dds  binary
*.mzp  binary
*.max  binary
*.fbx  binary
*.chm  binary
*.pdf  binary
*.db   binary
